/PLAN
/bin
/cmd/skein-desktop/build
/cmd/skein-desktop/wailsjs
/.env
/internal/web/dist/*
!/internal/web/dist/.gitkeep
/web/node_modules
/web/dist
*.test
/coverage.out
/backups

# Release artifacts from `make release`. Built, checksummed, and attached to
# a tag by hand or by CI - never committed.
/dist
/web/.test-build

# Docker: generated secrets and the setup report. The master key may be the
# only copy — see docs/DOCKER.md — so it must never be committed.
/data
skein-setup-info.txt
