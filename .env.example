# Skein configuration. Copy to .env for local development.
# Every SKEIN_* variable below without a default is required at boot.

SKEIN_ENV=development
SKEIN_ADDR=:8080
SKEIN_LOG_LEVEL=info
SKEIN_LOG_JSON=false

# Matches docker-compose.yml. Never point this at a production database.
SKEIN_DATABASE_URL=postgres://skein:skein@localhost:5433/skein?sslmode=disable

# 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# Losing this key makes every stored file permanently unreadable. Back it up
# somewhere that is not the same disk as the database.
#
# THE KEY ALONE IS NOT ENOUGH TO RECOVER YOUR FILES. Which shard lives on
# which drive, and in what order, is recorded only in Postgres. With the key
# but no database, the shards are unlabelled encrypted blobs and the files
# cannot be reassembled. Back up BOTH: `make backup` dumps the database, and
# the key belongs in a password manager. See "Backups" in the README.
SKEIN_MASTER_KEY=

# Signs access tokens. Separate from the master key so either can rotate
# independently. At least 32 characters.
#   openssl rand -base64 48
SKEIN_JWT_SECRET=

SKEIN_ACCESS_TOKEN_TTL=15m
SKEIN_REFRESH_TOKEN_TTL=720h

# Google OAuth. Create your own client id at console.cloud.google.com:
#   APIs & Services > Credentials > OAuth client ID > Web application
# Authorised redirect URI must match SKEIN_GOOGLE_REDIRECT_URL exactly.
# Scope is drive.file only: Skein can see only the files it created.
SKEIN_GOOGLE_CLIENT_ID=
SKEIN_GOOGLE_CLIENT_SECRET=
SKEIN_GOOGLE_REDIRECT_URL=http://localhost:8080/api/accounts/google/callback

# --- Desktop build only (cmd/skein-desktop) ---------------------------------
#
# The desktop app uses a DIFFERENT Google client from the server above, and
# they are not interchangeable. The server uses a "Web application" client with
# a redirect URI; the desktop app uses a "Desktop app" client on a loopback
# port (RFC 8252 PKCE). Using the web client for desktop fails at token
# exchange with `unauthorized_client` — that has already cost a live debugging
# session, so create both and keep them apart.
#
#   APIs & Services > Credentials > OAuth client ID > Desktop app
#
# BOTH are required for the desktop build. Google demands a secret at token
# exchange even for Desktop-type clients, despite the client being public.
# Leave both empty and the app builds and runs, but "Connect Google Drive"
# fails with "No Google client is configured for this app."
#
# The desktop binary can also carry these compiled in via -ldflags; these
# variables override that, for anyone who wants their own API quota.
SKEIN_GOOGLE_DESKTOP_CLIENT_ID=
SKEIN_GOOGLE_DESKTOP_CLIENT_SECRET=

SKEIN_PUBLIC_URL=http://localhost:8080

# Optional. Serves inline file previews from a separate origin so a malicious
# upload cannot reach the app's cookies. Strongly recommended in production.
SKEIN_PREVIEW_ORIGIN=

# Comma-separated CIDRs. X-Forwarded-For is honoured only from these peers.
# Empty means RemoteAddr is used, which is correct when nothing proxies Skein.
SKEIN_TRUSTED_PROXIES=

# Comma-separated origins allowed to call the API with credentials. Leave
# empty when the embedded UI is served from the same origin as the API.
SKEIN_CORS_ORIGINS=http://localhost:5173

# 100 GiB
SKEIN_MAX_UPLOAD_BYTES=107374182400
SKEIN_MAX_UPLOADS_PER_USER=10

# Operator token for the routes that dump the database or write to every
# connected drive: GET /api/system/backup and the manifest backfill/repair
# actions in Settings > Recovery.
#
# UNSET MEANS THOSE ROUTES RETURN 404, NOT 403 — a 403 would confirm the
# endpoint exists and is merely locked. So leaving this empty does not weaken
# anything; it removes the routes. The Recovery UI tells the user to set this
# when it is missing, which is why it belongs here.
#
# The DESKTOP build does not need it: the person clicking the button is the
# operator, so manifest writes are allowed without a token there.
#   openssl rand -base64 32
SKEIN_BACKUP_TOKEN=

# How shards are spread over connected drives.
#   most-available  (default) emptiest drive first, and a striped file prefers
#                   a drive not already holding one of its shards
#   priority        connection order; fills the first drive until it is full
#   round-robin     rotates per upload, for per-drive request quotas
SKEIN_ROUTING_POLICY=most-available

# Desktop only. Where "Save to disk" writes. Empty uses the XDG Downloads
# directory. This is TRUSTED configuration: it is never taken from a request.
SKEIN_DOWNLOAD_DIR=

SKEIN_SHUTDOWN_TIMEOUT=30s
SKEIN_QUOTA_SYNC_EVERY=5m
SKEIN_RECLAIM_EVERY=60s

# 256 MiB shards.
SKEIN_SHARD_SIZE_BYTES=268435456

# Off only for local debugging of the storage path. Files written while this
# is false stay plaintext; turning it back on does not re-encrypt them.
SKEIN_ENCRYPTION_ENABLED=true
