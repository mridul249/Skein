# Skein configuration. Copy to .env for local development.
# Every SKEIN_* variable below without a default is required at boot.

SKEIN_ENV=development
SKEIN_ADDR=:8080
SKEIN_LOG_LEVEL=info
SKEIN_LOG_JSON=false

# Matches docker-compose.yml. Never point this at a production database.
SKEIN_DATABASE_URL=postgres://skein:skein@localhost:5433/skein?sslmode=disable

# 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# Losing this key makes every stored file permanently unreadable. Back it up
# somewhere that is not the same disk as the database.
SKEIN_MASTER_KEY=

# Signs access tokens. Separate from the master key so either can rotate
# independently. At least 32 characters.
#   openssl rand -base64 48
SKEIN_JWT_SECRET=

SKEIN_ACCESS_TOKEN_TTL=15m
SKEIN_REFRESH_TOKEN_TTL=720h

# Google OAuth. Create your own client id at console.cloud.google.com:
#   APIs & Services > Credentials > OAuth client ID > Web application
# Authorised redirect URI must match SKEIN_GOOGLE_REDIRECT_URL exactly.
# Scope is drive.file only: Skein can see only the files it created.
SKEIN_GOOGLE_CLIENT_ID=
SKEIN_GOOGLE_CLIENT_SECRET=
SKEIN_GOOGLE_REDIRECT_URL=http://localhost:8080/api/accounts/google/callback

SKEIN_PUBLIC_URL=http://localhost:8080

# Optional. Serves inline file previews from a separate origin so a malicious
# upload cannot reach the app's cookies. Strongly recommended in production.
SKEIN_PREVIEW_ORIGIN=

# Comma-separated CIDRs. X-Forwarded-For is honoured only from these peers.
# Empty means RemoteAddr is used, which is correct when nothing proxies Skein.
SKEIN_TRUSTED_PROXIES=

# Comma-separated origins allowed to call the API with credentials. Leave
# empty when the embedded UI is served from the same origin as the API.
SKEIN_CORS_ORIGINS=http://localhost:5173

# 100 GiB
SKEIN_MAX_UPLOAD_BYTES=107374182400
SKEIN_MAX_UPLOADS_PER_USER=10

SKEIN_SHUTDOWN_TIMEOUT=30s
SKEIN_QUOTA_SYNC_EVERY=5m
SKEIN_RECLAIM_EVERY=60s

# 256 MiB shards.
SKEIN_SHARD_SIZE_BYTES=268435456

# Off only for local debugging of the storage path. Files written while this
# is false stay plaintext; turning it back on does not re-encrypt them.
SKEIN_ENCRYPTION_ENABLED=true
